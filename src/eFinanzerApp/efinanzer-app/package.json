{
  "name": "efinanzer-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "antd": "^6.6.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "generate:api": "openapi-typescript ../../eFinanzer/Web/OpenApi/efinanzer.json --output src/api/schema.d.ts",
    "generate:api:url": "openapi-typescript --output src/api/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@rc-component/(pagination|picker)/(locale|generate)/(.*)$": "<rootDir>/node_modules/@rc-component/$1/lib/$2/$3"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(antd|@ant-design|@rc-component|openapi-fetch)/)"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
