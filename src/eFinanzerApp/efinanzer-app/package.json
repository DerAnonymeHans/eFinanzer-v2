{
	"name": "efinanzer-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "vite dev",
		"build": "npm run check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "eslint .",
		"generate:api": "npx -y openapi-typescript@7 ../../eFinanzer/Web/OpenApi/efinanzer.json --output src/lib/api/schema.d.ts",
		"generate:api:url": "npx -y openapi-typescript@7 --output src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"keycloak-js": "^26.2.4",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
