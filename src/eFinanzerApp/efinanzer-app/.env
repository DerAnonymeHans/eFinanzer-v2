# Keycloak login (public client, authorization code flow with PKCE)
VITE_KEYCLOAK_URL=https://efinanzer.stura.htwk-leipzig.de/auth
VITE_KEYCLOAK_REALM=efinanzer
VITE_KEYCLOAK_CLIENT_ID=efinanzer-app
# VITE_API_BASE_URL is not set: in production the API is served from the same origin (see src/deploy/nginx.conf)
